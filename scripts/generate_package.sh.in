#! /bin/bash

VARIANT=$1
if [[ ${VARIANT} == "deb" ]]; then
    if [ -z "$3" ]; then
        echo "Error, OS name and architecture missing for deb package type"
        exit -1
    else
        OS=$2
	ARCH=$3
    fi
fi

VERSION_NO_SUFFIX="@VERSION_MAJOR@.@VERSION_MINOR@.@VERSION_PATCH@"
VERSION_SUFFIX="@VERSION_SUFFIX@"
VERSION="@VERSION_FULL@"

# Using CMAKE_BINARY_DIR uses an absolute path and will break cross-vm building/download/make functionality
BUILD_DIR="../"

VENDOR="@VENDOR@"
PROJECT="@PROJECT_NAME@"
DESC="@DESC@"
URL="@URL@"
EMAIL="@EMAIL@"

export BUILD_DIR
export VERSION_NO_SUFFIX
export VERSION_SUFFIX
export VERSION
export VENDOR
export PROJECT
export DESC
export URL
export EMAIL

validate_toolchain_version() {
    local bin_dir="${BUILD_DIR%/}/bin"
    local tool actual expected

    for tool in cdt-cpp cdt-cc cdt-ld cdt-abidiff cdt-init; do
        expected="${tool} version ${VERSION}"
        actual=$("${bin_dir}/${tool}" --version) || {
            echo "Error: unable to read ${tool} version"
            return 1
        }
        if [[ "${actual}" != "${expected}" ]]; then
            echo "Error: ${tool} version mismatch: expected '${expected}', got '${actual}'"
            return 1
        fi
    done

    local macros
    macros=$("${bin_dir}/cdt-cpp" -dM -E -x c++ /dev/null) || {
        echo "Error: unable to read CDT predefined version macros"
        return 1
    }
    for expected in \
        "#define __eosio_cdt_major__ @VERSION_MAJOR@" \
        "#define __eosio_cdt_minor__ @VERSION_MINOR@" \
        "#define __eosio_cdt_patchlevel__ @VERSION_PATCH@"; do
        if ! grep -Fxq "${expected}" <<<"${macros}"; then
            echo "Error: missing or incorrect compiler macro '${expected}'"
            return 1
        fi
    done
}

validate_toolchain_version || exit 1

mkdir -p tmp

if [[ ${VARIANT} == "brew" ]]; then
   . ./generate_bottle.sh
elif [[ ${VARIANT} == "deb" ]]; then
   . ./generate_deb.sh ${OS} ${ARCH}
elif [[ ${VARIANT} == "rpm" ]]; then
   . ./generate_rpm.sh
else
   echo "Error, unknown package type. Use either ['brew', 'deb', 'rpm']."
   exit -1
fi

rm -r tmp || exit 1
